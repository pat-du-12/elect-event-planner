<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for the "Planification des IRD" application.
  Requires the "HttpPlatformHandler" IIS module (v1.2+) and Node.js 20+ on the server.
  Place this file at the ROOT of the deployed folder (next to the .output directory).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\.output\server\index.mjs"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <!-- Port injected by IIS, read by the Node server -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NITRO_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Backend credentials: replace with the real values before deploying,
             or remove these lines and use a server-level .env / IIS app settings. -->
        <environmentVariable name="SUPABASE_URL" value="__SUPABASE_URL__" />
        <environmentVariable name="SUPABASE_PUBLISHABLE_KEY" value="__SUPABASE_PUBLISHABLE_KEY__" />
        <environmentVariable name="SUPABASE_SERVICE_ROLE_KEY" value="__SUPABASE_SERVICE_ROLE_KEY__" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Pièces jointes des IRD : jusqu'à 20 Mo -->
        <requestLimits maxAllowedContentLength="20971520" />
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
